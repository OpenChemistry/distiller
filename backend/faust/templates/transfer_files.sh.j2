#!/bin/bash
#      _ _     _   _ _ _
#     | (_)   | | (_) | |
#   __| |_ ___| |_ _| | | ___ _ __
#  / _` | / __| __| | | |/ _ \ '__|
# | (_| | \__ \ |_| | | |  __/ |
#  \__,_|_|___/\__|_|_|_|\___|_|
#
# Generated by Distiller for recorded Linux files using bbcp.
#SBATCH --qos={{ machine.qos }}
#SBATCH --constraint={{ machine.constraint }}
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=1
#SBATCH --time=02:00:00
#SBATCH --job-name=distiller-{{ job.job_type }}-files-{{ job.id }}
#SBATCH --account={{ machine.account }}
{%- if machine.reservation %}
#SBATCH --reservation={{ machine.reservation }}
{%- endif %}
#SBATCH --chdir={{ job_dir | shellquote }}

set -euo pipefail
mkdir -p -- {{ dest_dir | shellquote }}
destination=$(realpath -e -- {{ dest_dir | shellquote }})
{% for source_path, relative_path in files %}
target=$(realpath -m -- "$destination"/{{ relative_path | shellquote }})
case "$target" in
    "$destination/"*) ;;
    *) echo "Destination escapes scan directory" >&2; exit 1 ;;
esac
mkdir -p -- "$(dirname -- "$target")"
{{ settings.JOB_BBCP_EXECUTABLE_PATH | shellquote }} -z -f -V -s {{ settings.JOB_BBCP_NUMBER_OF_STREAMS }} \
    {{ (username ~ '@' ~ source_host ~ ':' ~ source_path) | shellquote }} "$target"
{% endfor %}
